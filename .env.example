# Gabarit. Copie ce fichier en `.env.local` et remplis les valeurs depuis
# Supabase > Settings > API Keys.
#
# `.env.local` est ignoré par git — c'est voulu. Ce fichier-ci a longtemps
# contenu de vraies valeurs, celles du projet « BETA », et pointait donc une
# nouvelle machine vers une base abandonnée.
#
# Le projet à utiliser est **Epicure-dev** (`daehifcdzrusxtzhtuxi`). Prends la
# clé `anon` / `publishable`, jamais la `service_role` : le préfixe VITE_ la
# compile dans le navigateur, où elle serait lisible par tout visiteur.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
